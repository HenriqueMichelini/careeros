[{"filePath":"/tmp/careeros-new-account-persistence/src/components/AccountGate.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/careeros-new-account-persistence/src/components/JourneyGuidance.tsx","messages":[{"ruleId":"sonarjs/no-nested-conditional","severity":2,"message":"Extract this nested ternary operation into an independent statement.","line":50,"column":19,"nodeType":"ConditionalExpression","messageId":"extractTernary","endLine":54,"endColumn":49},{"ruleId":"sonarjs/no-nested-conditional","severity":2,"message":"Extract this nested ternary operation into an independent statement.","line":52,"column":21,"nodeType":"ConditionalExpression","messageId":"extractTernary","endLine":54,"endColumn":49}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import type { Page } from \"../lib/types\"\nimport { hasQualificationEvidence } from \"../lib/qualificationEvidence\"\nimport { useI18n, useStore } from \"../lib/store\"\n\nexport default function JourneyGuidance({\n  page,\n  setPage,\n}: {\n  page: Page\n  setPage: (page: Page) => void\n}) {\n  const { state, profileDocument, profileSaving, accountId } = useStore()\n  const { t } = useI18n()\n  const profileReady =\n    !state.profileError &&\n    !profileSaving &&\n    hasQualificationEvidence(profileDocument)\n  const profileMessage = accountId\n    ? \"journey.accountProfile\"\n    : \"journey.profile\"\n  const guidance = {\n    landing: \"journey.apply\",\n    home: \"journey.apply\",\n    repository: profileMessage,\n    cv: \"journey.cv\",\n    results: \"journey.results\",\n  } as const\n  const needsProfile = page === \"home\" && !profileReady\n\n  return (\n    <section\n      aria-label={t(\"journey.context\")}\n      className=\"journey-guidance mx-auto max-w-6xl px-4 pt-6 sm:px-6\"\n    >\n      <div\n        className=\"flex flex-wrap items-start justify-between gap-3 border-b pb-4 text-sm\"\n        style={{ borderColor: \"var(--color-border)\" }}\n      >\n        <div className=\"min-w-0 max-w-2xl\">\n          <p className=\"font-semibold\">\n            {t(accountId ? \"journey.accountMode\" : \"journey.localMode\")}\n          </p>\n          <p className=\"mt-1\" style={{ color: \"var(--color-muted-fg)\" }}>\n            {t(guidance[page])}\n          </p>\n          {(page === \"repository\" || needsProfile) && (\n            <p className=\"mt-2\" role=\"status\" aria-atomic=\"true\">\n              {state.profileError\n                ? t(\"journey.profileUnavailable\")\n                : profileSaving\n                  ? t(\"journey.profileSaving\")\n                  : profileReady\n                    ? t(\"journey.profileReady\")\n                    : t(\"journey.profileNeeded\")}\n            </p>\n          )}\n        </div>\n        {(needsProfile || (page === \"repository\" && profileReady)) && (\n          <button\n            type=\"button\"\n            className=\"border px-4 py-2 font-semibold\"\n            style={{ borderColor: \"var(--color-fg)\" }}\n            onClick={() => setPage(needsProfile ? \"repository\" : \"home\")}\n          >\n            {t(needsProfile ? \"journey.openProfile\" : \"journey.continueApply\")}\n          </button>\n        )}\n      </div>\n    </section>\n  )\n}\n","usedDeprecatedRules":[]},{"filePath":"/tmp/careeros-new-account-persistence/src/lib/accountProfile.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/careeros-new-account-persistence/src/lib/store.tsx","messages":[{"ruleId":"sonarjs/no-nested-conditional","severity":2,"message":"Extract this nested ternary operation into an independent statement.","line":382,"column":19,"nodeType":"ConditionalExpression","messageId":"extractTernary","endLine":384,"endColumn":33}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { applyIngestionDocument } from \"./ingestionDocument\"\nimport { AccountProfile, applyAccountRetention } from \"./accountProfile\"\nimport type { IngestionResult } from \"./ingestion\"\nimport {\n  createContext,\n  useCallback,\n  useContext,\n  useEffect,\n  useMemo,\n  useReducer,\n  useRef,\n  useState,\n  ReactNode,\n} from \"react\"\nimport { ProfessionalRepository, GeneratedMaterials } from \"./types\"\nimport {\n  editProfile,\n  type ProfileEdit,\n  emptyProfileView,\n  migrateProfile,\n  profileView,\n  type ProfileDocument,\n} from \"./profileDocument\"\nimport {\n  applySectionProposal,\n  type SectionReviewRequest,\n  type SectionProposal,\n} from \"./sectionReview\"\nimport {\n  openProfile,\n  readProfile,\n  browserProfileLock,\n  saveProfile,\n  PROFILE_KEY,\n  LEGACY_KEY,\n  ProfileStorageError,\n  type ProfileStorageCode,\n} from \"./profileStorage\"\nimport {\n  getInitialLocale,\n  isLocale,\n  Locale,\n  translate,\n  TranslationKey,\n  TranslationValue,\n} from \"./i18n\"\n\ninterface AppState {\n  uiLocale: Locale\n  cvLanguage: Locale\n  profileError: ProfileStorageCode | null\n  generatedMaterials: GeneratedMaterials | null\n  lastAcceptedMaterials: GeneratedMaterials | null\n  typesafeKey: string\n  apiKey: string\n  isReviewingRepo: boolean\n  isGenerating: boolean\n  lastReviewSummary: string\n  jobPosting: string\n  applicationRevision: number\n}\n\ntype Action = { type: \"NEW_APPLICATION\" } | {\n  type: \"SET_TYPESAFE_KEY\"\n  payload: string\n} | {\n  type: \"SET_CV_LANGUAGE\"\n  payload: Locale\n} | {\n  type: \"SET_UI_LOCALE\"\n  payload: Locale\n} | {\n  type: \"SET_MATERIALS\"\n  payload: GeneratedMaterials\n} | {\n  type: \"SET_API_KEY\"\n  payload: string\n} | {\n  type: \"SET_REVIEWING\"\n  payload: boolean\n} | {\n  type: \"SET_GENERATING\"\n  payload: boolean\n} | {\n  type: \"SET_REVIEW_SUMMARY\"\n  payload: string\n} | {\n  type: \"SET_JOB_POSTING\"\n  payload: string\n}\n\nfunction reducer(state: AppState, action: Action): AppState {\n  switch (action.type) {\n    case \"NEW_APPLICATION\":\n      return {\n        ...state,\n        jobPosting: \"\",\n        applicationRevision: state.applicationRevision + 1,\n      }\n    case \"SET_UI_LOCALE\":\n      return { ...state, uiLocale: action.payload }\n    case \"SET_CV_LANGUAGE\":\n      return { ...state, cvLanguage: action.payload }\n    case \"SET_MATERIALS\":\n      return {\n        ...state,\n        generatedMaterials: action.payload,\n        lastAcceptedMaterials:\n          action.payload.acceptedResume || action.payload.acceptedArtifacts\n            ? action.payload\n            : state.lastAcceptedMaterials,\n      }\n    case \"SET_TYPESAFE_KEY\":\n      return { ...state, typesafeKey: action.payload }\n    case \"SET_API_KEY\":\n      return { ...state, apiKey: action.payload }\n    case \"SET_REVIEWING\":\n      return { ...state, isReviewingRepo: action.payload }\n    case \"SET_GENERATING\":\n      return { ...state, isGenerating: action.payload }\n    case \"SET_REVIEW_SUMMARY\":\n      return { ...state, lastReviewSummary: action.payload }\n    case \"SET_JOB_POSTING\":\n      return { ...state, jobPosting: action.payload }\n    default:\n      return state\n  }\n}\n\nfunction readSetting(key: string): string {\n  try {\n    return localStorage.getItem(key) || \"\"\n  } catch {\n    return \"\"\n  }\n}\n\nfunction writeSetting(key: string, value: string) {\n  try {\n    if (value) localStorage.setItem(key, value)\n    else localStorage.removeItem(key)\n  } catch {\n    /* Profile persistence reports its own errors. */\n  }\n}\n\nfunction loadCvLanguage(): Locale {\n  try {\n    const saved = localStorage.getItem(\"careeros_cv_language\")\n    if (isLocale(saved)) return saved\n    const document = JSON.parse(\n      localStorage.getItem(\"careeros_curated_cv_v1\") || \"null\",\n    )\n    const previous = document?.cvLanguage ?? document?.locale\n    if (isLocale(previous)) return previous\n  } catch {\n    /* Use the initial site language for a new CV preference. */\n  }\n  return getInitialLocale()\n}\n\nconst StoreContext = createContext<{\n  state: AppState & { repository: ProfessionalRepository }\n  dispatch: (action: Action) => Promise<boolean>\n  profileDocument: ProfileDocument | null\n  profileSaving: boolean\n  accountId: string | null\n  saveCanonicalCandidate: (\n    expected: ProfileDocument,\n    candidate: ProfileDocument,\n  ) => Promise<boolean>\n  refreshCanonicalProfile: () => Promise<boolean>\n  editCanonicalProfile: (edit: ProfileEdit) => Promise<boolean>\n  applyIngestionProposal: (\n    snapshot: ProfileDocument,\n    input: string,\n    result: IngestionResult,\n  ) => Promise<boolean>\n  applyProfileProposal: (\n    request: SectionReviewRequest,\n    proposal: SectionProposal,\n    edits: Record<string, string>,\n    removals: string[],\n  ) => Promise<boolean>\n} | null>(null)\n\nexport function StoreProvider({\n  children,\n  account,\n}: Readonly<{\n  children: ReactNode\n  account?: AccountProfile\n}>) {\n  const [profileDocument, setProfileDocument] =\n    useState<ProfileDocument | null>(null)\n  const optimisticDocument = useRef<ProfileDocument | null>(null)\n  const documentRef = useRef<ProfileDocument | null>(null)\n  const queue = useRef<Promise<boolean>>(Promise.resolve(true))\n  const failed = useRef(false)\n  const [ready, setReady] = useState(false)\n  const [pendingProfileWrites, setPendingProfileWrites] = useState(0)\n  const [profileError, setProfileError] = useState<ProfileStorageCode | null>(\n    null,\n  )\n  const [state, rawDispatch] = useReducer(reducer, {\n    uiLocale: getInitialLocale(),\n    cvLanguage: account ? getInitialLocale() : loadCvLanguage(),\n    profileError: null,\n    generatedMaterials: null,\n    lastAcceptedMaterials: null,\n    typesafeKey: account ? \"\" : readSetting(\"careeros_typesafe_key\"),\n    apiKey: account ? \"\" : readSetting(\"careeros_apikey\"),\n    isReviewingRepo: false,\n    isGenerating: false,\n    lastReviewSummary: \"\",\n    applicationRevision: 0,\n    jobPosting: \"\",\n  })\n\n  useEffect(() => {\n    let active = true\n    Promise.resolve()\n      .then(() => (account ? account.open() : openProfile(localStorage)))\n      .then((doc) => {\n        if (!active) return\n        const pending = account?.recovery()\n        // The current server read succeeded before any recovery draft is shown.\n        // documentRef remains server authority; pending wording is unsaved.\n        optimisticDocument.current = pending?.document ?? doc\n        setProfileDocument(pending?.document ?? doc)\n        documentRef.current = doc\n        if (account?.hasRecovery()) {\n          failed.current = true\n          setProfileError(pending ? \"uncertain\" : \"validation\")\n        }\n        setReady(true)\n      })\n      .catch((error) => {\n        if (!active) return\n        if (!account) {\n          // The existing browser-only mode retains its recovery behavior.\n          try {\n            const raw = localStorage.getItem(LEGACY_KEY)\n            if (localStorage.getItem(PROFILE_KEY) === null && raw !== null) {\n              const recovered = migrateProfile(\n                JSON.parse(raw),\n                crypto.randomUUID(),\n              )\n              optimisticDocument.current = recovered\n              setProfileDocument(recovered)\n            }\n          } catch {\n            /* Malformed originals are retained for download. */\n          }\n        }\n        failed.current = true\n        setProfileError(\n          error instanceof ProfileStorageError ? error.code : \"storage\",\n        )\n        setReady(true)\n      })\n    const changed = (event: StorageEvent) => {\n      if (account) return\n      if (event.key !== PROFILE_KEY && event.key !== null) return\n      if (\n        !documentRef.current ||\n        event.newValue === JSON.stringify(documentRef.current)\n      )\n        return\n      // Keep the local draft and review input, but block stale writes until reload.\n      failed.current = true\n      setProfileError(\"stale\")\n    }\n    window.addEventListener(\"storage\", changed)\n    return () => {\n      active = false\n      window.removeEventListener(\"storage\", changed)\n    }\n  }, [])\n\n  const commit = useCallback(\n    async (expected: ProfileDocument, candidate: ProfileDocument) => {\n      if (account)\n        return account.save(\n          expected,\n          applyAccountRetention(expected, candidate),\n        )\n      await saveProfile(localStorage, expected, candidate)\n      return candidate\n    },\n    [account],\n  )\n\n  const updateCanonical = useCallback(\n    (build: (doc: ProfileDocument) => ProfileDocument) => {\n      const expected = optimisticDocument.current\n      if (!expected) return Promise.resolve(false)\n      // Keep a second editor's draft outside the pending operation. Recovery of\n      // the first Save must never replace a newer optimistic unsaved candidate.\n      if (account && (failed.current || expected !== documentRef.current))\n        return Promise.resolve(false)\n      let candidate: ProfileDocument\n      try {\n        candidate = build(expected)\n        if (account) candidate = applyAccountRetention(expected, candidate)\n      } catch {\n        setProfileError(\"validation\")\n        return Promise.resolve(false)\n      }\n      optimisticDocument.current = candidate\n      setProfileDocument(candidate)\n      setPendingProfileWrites((count) => count + 1)\n      const saving = queue.current\n        .then(async () => {\n          if (failed.current || !documentRef.current) return false\n          try {\n            const saved = await commit(expected, candidate)\n            documentRef.current = saved\n            if (account && optimisticDocument.current === candidate) {\n              optimisticDocument.current = saved\n              setProfileDocument(saved)\n            }\n            return true\n          } catch (error) {\n            failed.current = true\n            setProfileError(\n              error instanceof ProfileStorageError ? error.code : \"validation\",\n            )\n            return false\n          }\n        })\n        .finally(() => setPendingProfileWrites((count) => count - 1))\n      queue.current = saving\n      return saving\n    },\n    [commit, account],\n  )\n  const refreshCanonicalProfile = useCallback(() => {\n    const refreshing = queue.current.then(async () => {\n      try {\n        const current = account\n          ? await account.refresh()\n          : await browserProfileLock(() => readProfile(localStorage))\n        documentRef.current = current\n        optimisticDocument.current = current\n        failed.current = false\n        setProfileDocument(current)\n        setProfileError(null)\n        return true\n      } catch (error) {\n        setProfileError(\n          error instanceof ProfileStorageError ? error.code : \"storage\",\n        )\n        return false\n      }\n    })\n    queue.current = refreshing\n    return refreshing\n  }, [account])\n  const editCanonicalProfile = useCallback(\n    (edit: ProfileEdit) => updateCanonical((doc) => editProfile(doc, edit)),\n    [updateCanonical],\n  )\n  const persistProposal = useCallback(\n    (build: (expected: ProfileDocument) => ProfileDocument) => {\n      setPendingProfileWrites((count) => count + 1)\n      const saving = queue.current\n        .then(async () => {\n          const expected = documentRef.current\n          if (failed.current || !expected) return false\n          try {\n            const candidate = build(expected)\n            const saved = await commit(expected, candidate)\n            documentRef.current = saved\n            optimisticDocument.current = saved\n            setProfileDocument(saved)\n            return true\n          } catch (error) {\n            setProfileError(\n              error instanceof ProfileStorageError\n                ? error.code\n                : error instanceof Error && error.message === \"stale\"\n                  ? \"stale\"\n                  : \"validation\",\n            )\n            return false\n          }\n        })\n        .finally(() => setPendingProfileWrites((count) => count - 1))\n      queue.current = saving\n      return saving\n    },\n    [commit],\n  )\n  const saveCanonicalCandidate = useCallback(\n    (expected: ProfileDocument, candidate: ProfileDocument) =>\n      persistProposal((doc) => {\n        if (JSON.stringify(doc) !== JSON.stringify(expected))\n          throw new ProfileStorageError(\"stale\")\n        return candidate\n      }),\n    [persistProposal],\n  )\n  const applyIngestionProposal = useCallback(\n    (snapshot: ProfileDocument, input: string, result: IngestionResult) =>\n      persistProposal((doc) =>\n        applyIngestionDocument(doc, snapshot, input, result),\n      ),\n    [persistProposal],\n  )\n  const applyProfileProposal = useCallback(\n    (\n      request: SectionReviewRequest,\n      proposal: SectionProposal,\n      edits: Record<string, string>,\n      removals: string[],\n    ) =>\n      persistProposal((doc) =>\n        applySectionProposal(doc, request, proposal, edits, removals),\n      ),\n    [persistProposal],\n  )\n  const dispatch = useCallback(async (action: Action) => {\n    rawDispatch(action)\n    return true\n  }, [])\n\n  function downloadRecovery() {\n    const data: Record<string, unknown> = {\n      unsavedProfile: optimisticDocument.current\n        ? profileView(optimisticDocument.current)\n        : null,\n      unsavedCanonicalProfile: optimisticDocument.current,\n      ...(account ? { accountRecovery: account.recoveryExport() } : {}),\n    }\n    for (const key of account ? [] : [LEGACY_KEY, PROFILE_KEY]) {\n      try {\n        data[key] = localStorage.getItem(key)\n      } catch {\n        data[key] = null\n      }\n    }\n    const url = URL.createObjectURL(\n      new Blob([JSON.stringify(data, null, 2)], { type: \"application/json\" }),\n    )\n    const anchor = document.createElement(\"a\")\n    anchor.href = url\n    anchor.download = \"careeros-profile-recovery.json\"\n    anchor.click()\n    setTimeout(() => URL.revokeObjectURL(url), 1000)\n  }\n\n  useEffect(() => {\n    if (!account) writeSetting(\"careeros_typesafe_key\", state.typesafeKey)\n  }, [state.typesafeKey])\n\n  useEffect(() => {\n    if (!account) writeSetting(\"careeros_apikey\", state.apiKey)\n  }, [state.apiKey])\n\n  useEffect(() => {\n    writeSetting(\"careeros_locale\", state.uiLocale)\n    document.documentElement.lang = state.uiLocale\n  }, [state.uiLocale])\n\n  useEffect(() => {\n    writeSetting(\"careeros_cv_language\", state.cvLanguage)\n  }, [state.cvLanguage])\n\n  const repository = useMemo(\n    () => (profileDocument ? profileView(profileDocument) : emptyProfileView()),\n    [profileDocument],\n  )\n  const accountSaveState = pendingProfileWrites > 0 ? \"pending\" : account?.state\n  const pendingAccountMessage =\n    state.uiLocale === \"pt-BR\"\n      ? \"O Perfil ainda não foi confirmado. Suas alterações continuam disponíveis nesta sessão. Baixe a cópia antes de sair ou recarregar.\"\n      : \"Your Profile is not confirmed saved. Your edits remain available in this session. Download a copy before leaving or reloading.\"\n\n  return (\n    <StoreContext.Provider\n      value={{\n        state: { ...state, profileError, repository },\n        dispatch,\n        profileDocument,\n        profileSaving: pendingProfileWrites > 0,\n        accountId: account?.accountId ?? null,\n        saveCanonicalCandidate,\n        editCanonicalProfile,\n        refreshCanonicalProfile,\n        applyProfileProposal,\n        applyIngestionProposal,\n      }}\n    >\n      {profileError && (\n        <div\n          role=\"alert\"\n          className=\"border-b border-amber-300 bg-amber-50 px-4 py-3 text-sm text-amber-950\"\n        >\n          <p>\n            {account\n              ? pendingAccountMessage\n              : translate(\n                  state.uiLocale,\n                  `profile.persistence.${profileError}`,\n                )}\n          </p>\n          {account?.hasRecovery() && !account.checkpointStored && (\n            <p>\n              {state.uiLocale === \"pt-BR\"\n                ? \"O armazenamento de recuperação está indisponível. Mantenha esta aba aberta e baixe uma cópia antes de sair.\"\n                : \"Recovery storage is unavailable. Keep this tab open and download a copy before leaving.\"}\n            </p>\n          )}\n          <div className=\"mt-2 flex gap-4\">\n            <button\n              type=\"button\"\n              className=\"underline\"\n              onClick={downloadRecovery}\n            >\n              {translate(state.uiLocale, \"profile.persistence.download\")}\n            </button>\n            {account?.recovery() && (\n              <button\n                type=\"button\"\n                disabled={pendingProfileWrites > 0}\n                className=\"underline\"\n                onClick={() => {\n                  setPendingProfileWrites((count) => count + 1)\n                  void account\n                    .retry()\n                    .then((saved) => {\n                      documentRef.current = saved\n                      optimisticDocument.current = saved\n                      setProfileDocument(saved)\n                      failed.current = false\n                      setProfileError(null)\n                    })\n                    .catch((error) =>\n                      setProfileError(\n                        error instanceof ProfileStorageError\n                          ? error.code\n                          : \"uncertain\",\n                      ),\n                    )\n                    .finally(() =>\n                      setPendingProfileWrites((count) => count - 1),\n                    )\n                }}\n              >\n                {state.uiLocale === \"pt-BR\"\n                  ? \"Tentar o mesmo salvamento\"\n                  : \"Retry the same Save\"}\n              </button>\n            )}\n            {account?.hasRecovery() && (\n              <button\n                type=\"button\"\n                data-discard-recovery\n                disabled={pendingProfileWrites > 0}\n                className=\"underline\"\n                onClick={() => {\n                  if (\n                    !window.confirm(\n                      state.uiLocale === \"pt-BR\"\n                        ? \"Descartar a cópia de recuperação e recarregar o Perfil da conta? Isso não desfaz um salvamento no servidor.\"\n                        : \"Discard the recovery copy and reload your account Profile? This does not undo a server Save.\",\n                    )\n                  )\n                    return\n                  try {\n                    account.discardRecovery()\n                    void refreshCanonicalProfile()\n                  } catch {\n                    setProfileError(\"storage\")\n                  }\n                }}\n              >\n                {state.uiLocale === \"pt-BR\"\n                  ? \"Descartar cópia de recuperação\"\n                  : \"Discard recovery copy\"}\n              </button>\n            )}\n            <button\n              type=\"button\"\n              className=\"underline\"\n              data-profile-refresh\n              onClick={() => void refreshCanonicalProfile()}\n            >\n              {translate(state.uiLocale, \"profile.persistence.reload\")}\n            </button>\n          </div>\n        </div>\n      )}\n      {account && accountSaveState && (\n        <output\n          className=\"block border-b px-4 py-2 text-sm\"\n          data-account-save-state={accountSaveState}\n        >\n          {state.uiLocale === \"pt-BR\"\n            ? {\n                idle: \"Alterações exigem Salvar.\",\n                pending: \"Salvando…\",\n                failed: \"Não foi salvo. Alterações mantidas.\",\n                uncertain:\n                  \"Confirmação pendente. Verifique antes de tentar outra alteração.\",\n                confirmed: `Salvamento confirmado na revisão ${account.historicalRevision}.`,\n              }[accountSaveState]\n            : {\n                idle: \"Changes require Save.\",\n                pending: \"Saving…\",\n                failed: \"Save failed. Edits retained.\",\n                uncertain:\n                  \"Save outcome is uncertain. Check before making another change.\",\n                confirmed: `Save confirmed at revision ${account.historicalRevision}.`,\n              }[accountSaveState]}\n        </output>\n      )}\n      {ready ? (\n        children\n      ) : (\n        <p role=\"status\" className=\"p-4\">\n          {translate(state.uiLocale, \"profile.persistence.loading\")}\n        </p>\n      )}\n    </StoreContext.Provider>\n  )\n}\n\nexport function useStore() {\n  const ctx = useContext(StoreContext)\n  if (!ctx) throw new Error(\"useStore must be inside StoreProvider\")\n  return ctx\n}\n\nexport function useI18n() {\n  const { state, dispatch } = useStore()\n  const t = useCallback(\n    (key: TranslationKey, values?: Record<string, TranslationValue>) =>\n      translate(state.uiLocale, key, values),\n    [state.uiLocale],\n  )\n  const setUiLocale = useCallback(\n    (locale: Locale) => dispatch({ type: \"SET_UI_LOCALE\", payload: locale }),\n    [dispatch],\n  )\n\n  return { uiLocale: state.uiLocale, setUiLocale, t }\n}\n","usedDeprecatedRules":[]},{"filePath":"/tmp/careeros-new-account-persistence/tests/account-browser.check.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/careeros-new-account-persistence/tests/account-browser.fixture.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/careeros-new-account-persistence/tests/account-harness.tsx","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"/tmp/careeros-new-account-persistence/tests/account-session-browser.check.mjs","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]
