{
  "name": "figma-make-app",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:review-api": "go run ./cmd/profile-review",
    "build": "vite build",
    "test": "node --test tests/*.test.mjs",
    "test:ingestion-browser": "node tests/submission-journey.check.mjs",
    "test:review-renderer": "node tests/review-renderer.check.mjs",
    "test:application-reuse": "node tests/application-reuse-browser.check.mjs",
    "test:apply-checklist": "node tests/apply-checklist.check.mjs",
    "test:cv-pdf": "node tests/cv-pdf.check.mjs",
    "test:cv-preview": "node tests/cv-shared-preview.check.mjs",
    "test:results-firefox-pdf": "node tests/results-firefox-print.check.mjs",
    "preview": "vite preview",
    "format": "oxfmt",
    "test:cv-generation": "node tests/cv-generation-browser.check.mjs",
    "test:preview-inspection": "node tests/preview-inspection-browser.check.mjs",
    "test:preview-provider": "node tests/preview-provider-browser.check.mjs",
    "build:lab": "vite build --config vite.lab.config.ts",
    "lab": "node scripts/lab.mjs"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^6.0.0",
    "tailwindcss": "^4.0.0",
    "@tailwindcss/vite": "^4.0.0",
    "oxfmt": "^0.2.0",
    "typescript": "^5.7.0",
    "vite": "^8.0.5"
  }
}
